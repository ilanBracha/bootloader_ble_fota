################################################################################
# User build rules for the OTA bootloader.
#
# This file is NOT generated by e2 studio - the generated Debug/makefile ends with
# "-include ../makefile.targets", which pulls these rules in for every build configuration.
################################################################################

OBJCOPY := arm-none-eabi-objcopy
SIZE    := arm-none-eabi-size

# Keep in sync with src/boot_layout.h.
BOOT_BOOTLOADER_SIZE ?= 0x4000
BOOT_PRIMARY_BASE    ?= 0x10000

# Sections that must not appear in the raw flash image: option settings (0x0100Axxx) and data flash (0x08000000).
BOOT_BIN_EXCLUDE := -R .option_setting* -R __option_setting* -R *data_flash*

FACTORY_SCRIPT := ../script/make_factory.ps1

# Application image programmed into the primary slot for the factory download.
# Usage: make factory.bin APP_BIN=../../ota_fw_app_ra6e2/Debug/app.bin
APP_BIN ?=

# Hook the bootloader artefacts into the normal build.
secondary-outputs: bootloader.elf bootloader.bin

bootloader.elf: ota_fw_bootloader.elf
	@echo Creating bootloader.elf && $(OBJCOPY) ota_fw_bootloader.elf bootloader.elf

# The size guard also catches a script/fsp.ld that lost its FLASH_LENGTH override, which
# "Generate Project Content" does every time it regenerates the linker script.
bootloader.bin: ota_fw_bootloader.elf
	@echo Creating bootloader.bin && $(OBJCOPY) -O binary -w --gap-fill 0xFF $(BOOT_BIN_EXCLUDE) ota_fw_bootloader.elf bootloader.bin
	@powershell -NoProfile -ExecutionPolicy Bypass -File "../script/check_size.ps1" -Image bootloader.bin -Limit $(BOOT_BOOTLOADER_SIZE) -Name bootloader

# Combined first-download image: bootloader padded up to the primary slot base, followed by the application.
factory.bin: bootloader.bin
	powershell -NoProfile -ExecutionPolicy Bypass -File "$(FACTORY_SCRIPT)" -Bootloader bootloader.bin -App "$(APP_BIN)" -Base $(BOOT_PRIMARY_BASE) -Out factory.bin

.PHONY: bootloader-size
bootloader-size: ota_fw_bootloader.elf
	@$(SIZE) --format=berkeley ota_fw_bootloader.elf